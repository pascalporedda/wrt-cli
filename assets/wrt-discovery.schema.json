{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wrt project discovery version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "port_stride", "ports", "commands", "compose", "supabase"],
  "properties": {
    "version": { "type": "integer", "const": 2 },
    "port_stride": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "base_port", "outputs"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "base_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["env", "template"],
              "properties": {
                "env": { "type": "string", "pattern": "^(?!WRT_)[A-Za-z_][A-Za-z0-9_]*$" },
                "template": { "type": "string", "pattern": "^[^{}]*(?:\\{port\\}[^{}]*)+$" }
              }
            }
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup", "start", "stop", "status", "db_migrate", "db_seed", "db_reset"],
      "properties": {
        "setup": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["argv", "cwd"],
          "properties": {
            "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "cwd": { "type": ["string", "null"], "minLength": 1 }
          }
        },
        "start": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["argv", "cwd"],
          "properties": {
            "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "cwd": { "type": ["string", "null"], "minLength": 1 }
          }
        },
        "stop": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["argv", "cwd"],
          "properties": {
            "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "cwd": { "type": ["string", "null"], "minLength": 1 }
          }
        },
        "status": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["argv", "cwd"],
          "properties": {
            "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "cwd": { "type": ["string", "null"], "minLength": 1 }
          }
        },
        "db_migrate": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["argv", "cwd"],
          "properties": {
            "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "cwd": { "type": ["string", "null"], "minLength": 1 }
          }
        },
        "db_seed": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["argv", "cwd"],
          "properties": {
            "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "cwd": { "type": ["string", "null"], "minLength": 1 }
          }
        },
        "db_reset": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["argv", "cwd"],
          "properties": {
            "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "cwd": { "type": ["string", "null"], "minLength": 1 }
          }
        }
      }
    },
    "compose": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "supabase": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["config_path"],
      "properties": {
        "config_path": { "type": "string", "minLength": 1 }
      }
    }
  }
}
